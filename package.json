{
  "name": "primehr-desktop",
  "version": "0.1.0",
  "description": "PrimeHR Documents Dashboard — scaffold Electron (host/client LAN)",
  "main": "dist-electron/electron/main.js",
  "author": "Prime HR Solutions",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/ensure-electron.cjs",
    "ensure:electron": "node scripts/ensure-electron.cjs",
    "dev": "npm run dev:web",
    "dev:web": "cross-env PRIMEHR_MODE=host PRIMEHR_PORT=3847 concurrently -k \"npm:dev:server\" \"npm:dev:vite\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 tcp:3847 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 tsx electron/main.ts",
    "dev:host": "npm run dev:web",
    "dev:host:desktop": "cross-env PRIMEHR_MODE=host PRIMEHR_PORT=3847 concurrently -k \"npm:dev:server\" \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:client": "cross-env PRIMEHR_MODE=client npm run dev:vite",
    "dev:client:desktop": "cross-env PRIMEHR_MODE=client concurrently -k \"npm:dev:vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 PRIMEHR_MODE=client tsx electron/main.ts\"",
    "server:only": "tsx server/index.ts",
    "build": "tsc -p tsconfig.node.json && node scripts/write-preload.cjs && vite build",
    "build:win": "node scripts/ensure-electron.cjs --strict && npm run build && electron-builder --config electron-builder.yml --win --x64",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "sql.js": "^1.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
